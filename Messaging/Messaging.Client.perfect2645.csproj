<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Messaging.Client.perfect2645</PackageId>
    <Version>2.1.0</Version>
    <Authors>Fawei</Authors>
    <Company>Personal</Company>
    <Product>Messaging.Client</Product>
    <Description>.net c# messaging client library.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 Fawei</Copyright>
    <PackageProjectUrl>https://github.com/perfect2645/Laboratory/tree/main/Messaging</PackageProjectUrl>
  	<RepositoryUrl>https://github.com/perfect2645/Laboratory/tree/main/Messaging</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>.net C# messaging httpclient</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="README.md" Pack="true" PackagePath="\">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Csharp.Utils.perfect2645" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.*" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="10.*" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.*" />
  </ItemGroup>
</Project>
